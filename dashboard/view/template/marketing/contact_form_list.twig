{{ header }}
{{ column_left }}

<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa fa-envelope"></i> Contact Form Entries</div>
      <div class="card-body">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>{{ column_name }}</th>
              <th>{{ column_email }}</th>
              <th>{{ column_phone }}</th>
              <th>{{ column_message }}</th>
              <th>{{ column_date_added }}</th>
              <th class="text-end">{{ column_action }}</th>
            </tr>
          </thead>
          <tbody>
            {% for contact in contacts %}
            <tr>
              <td>{{ contact.name }}</td>
              <td>{{ contact.email }}</td>
              <td>{{ contact.phone }}</td>
              <td>{{ contact.message }}</td>
              <td>{{ contact.date_added }}</td>
              <td class="text-end">
                <a href="{{ delete }}&contact_id={{ contact.contact_id }}" 
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure you want to delete this entry?');">
                  <i class="fa fa-trash"></i> Delete
                </a>
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="6" class="text-center">{{ text_no_results }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

{{ footer }}

{{ header }}
{{ column_left }}

<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>Referral Management</h1>
    </div>
  </div>

  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <i class="fa fa-users"></i> Referral List
      </div>

      <div class="card-body">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>Referrer (Existing Customer)</th>
              <th>Referred Person</th>
              <th>Mobile</th>
              <th>Account Created?</th>
              <th>First Order?</th>
              <th>Order ID</th>
              <th>Date Referred</th>
              <th>Reward Status</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            {% for referral in referrals %}
            <tr>

              <td>
                {{ referral.referrer_firstname }} {{ referral.referrer_lastname }}
              </td>

              <td>{{ referral.referrer_name }}</td>

              <td>{{ referral.referrer_mobile }}</td>

            <td>
  {% if referral.referred_customer_id %}
    <span class="badge bg-success">Yes</span>
  {% else %}
    <span class="badge bg-danger">No</span>
  {% endif %}
</td>

<!-- <td>
  {% if referral.order_id %}
    <span class="badge bg-success">Yes</span>
  {% else %}
    <span class="badge bg-warning">No</span>
  {% endif %}
</td> -->
<td>
  {% if referral.referred_first_order_id %}
    <span class="badge bg-success">Yes</span>
  {% else %}
    <span class="badge bg-warning text-dark">No</span>
  {% endif %}
</td>

<td>{{ referral.order_id ?: '-' }}</td>

<td>{{ referral.date_added }}</td>

<td>
  {% if referral.reward_given %}
    <span class="badge bg-success">Rewarded</span>
  {% else %}
    <a href="index.php?route=marketing/referral.reward&user_token={{ user_token }}&referral_id={{ referral.referral_id }}"
       class="btn btn-primary btn-sm"
       onclick="return confirm('Give reward points to referrer?')">
       Give Reward
    </a>
  {% endif %}
</td>

<td>
  <a href="index.php?route=marketing/referral.delete&user_token={{ user_token }}&referral_id={{ referral.referral_id }}"
     class="btn btn-danger btn-sm"
     onclick="return confirm('Are you sure you want to delete this referral?')">
     Delete
  </a>
</td>

            </tr>
            {% else %}
            <tr>
              <td colspan="9" class="text-center">
                No referrals found!
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>

{{ footer }}
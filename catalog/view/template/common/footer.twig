    <div class="row gy-4 align-items-start justify-content-between pb-md-4">
      
      <!-- Logo & Social -->
      <div class="col-12 col-lg-4">
        <div class="logo-box">
          <a href="{{ home }}" class="footer-logo d-block mb-3">
            <img src="{{ base }}image/catalog/peptoply/peptoply-logo.svg" alt="{{ config_name }} logo" class="img-fluid w-100">
          </a>
          <div class="d-flex gap-md-4 gap-3 mt-md-5 mt-4">
            <!-- <a href="https://twitter.com/peptoply" class="icon" target="_blank" rel="noopener" aria-label="Twitter"><i class="fa-brands fa-twitter fa-lg"></i></a> -->
            <a href="https://facebook.com/peptoply" class="icon" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f fa-lg"></i></a>
            <a href="https://instagram.com/peptoply" class="icon" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram fa-lg"></i></a>
          </div>
        </div>

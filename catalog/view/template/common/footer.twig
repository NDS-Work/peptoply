</main>
<div id="gst-global-loader" style="display: none !important;">
    <div class="gst-spinner"></div>
</div>

<style>
#gst-global-loader {
    display: none; /* 🔥 MUST be none initially */
    position: fixed;
    inset: 0;
    background: rgba(255,255,255,0.7);
    z-index: 9999;

    /* flex only when shown */
    align-items: center;
    justify-content: center;
}

#gst-global-loader.active {
    display: flex; /* 🔥 ONLY when active */
}

.gst-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #ccc;
    border-top-color: #007bff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>

<script>
  function showGSTLoader() {
    $('#gst-global-loader').addClass('active');
}

function hideGSTLoader() {
    $('#gst-global-loader').removeClass('active');
}
  </script>

          {% endif %}
          {% if store_email %}
            <li class="mb-2"><i class="fa-solid fa-envelope me-2"></i>
              <a href="mailto:{{ store_email }}" class="footer-link">{{ store_email }}</a>
            </li>
          {% endif %}
          {% if store_address %}
            <li><i class="fa-solid fa-location-dot me-2"></i> {{ store_address|raw }}</li>
          {% endif %}
        </ul>
      </div>
    </div>

    <hr class="my-md-3 my-1">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 pt-2 small text-muted">
      <div>
        © {{ "now"|date("Y") }} {{ config_name }} | Website by 

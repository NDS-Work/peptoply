                        <td>{{ attribute.name }}</td>
                        <td>{{ attribute.text }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                {% endfor %}
              </table>
            </div>
          </div>
        {% endif %}
        {% if review_status %}
          <div id="tab-review" class="tab-pane fade mb-4">{{ review }}</div>
        {% endif %}
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

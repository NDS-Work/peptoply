});

// Quantity +/- buttons
function setQty(nextQty) {
    var minQty = parseInt('{{ minimum }}', 10) || 1;
    var qty = parseInt(nextQty, 10);

    if (!qty || qty < minQty) qty = minQty;

    $('#input-quantity').val(qty).removeClass('is-invalid');
}

$(document).on('click', '#button-qty-minus', function () {
    var current = parseInt($('#input-quantity').val(), 10) || 0;
    setQty(current - 1);
});

$(document).on('click', '#button-qty-plus', function () {
    var current = parseInt($('#input-quantity').val(), 10) || 0;
    setQty(current + 1);
});

$(document).on('blur', '#input-quantity', function () {
    setQty($('#input-quantity').val());
});


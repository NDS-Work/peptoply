<script>
(function() {
    // ---- utilities
    function renderPrice(json) {
        // If there's a special (sale) after options, update both old/new spans
        if (json['original_special'] && json['original_special'].length > 0) {
            if ($('.price-old').length) {
                $('.price-old').text(json['original_price']);
            }
            // If price-old doesn't exist (e.g., page initially had no special), create it before price-new
            if (!$('.price-old').length && $('.price-new').length) {
                var li = $('.price-new').closest('li');
                if (li.length) {
                    $('<li><span class="price-old"></span></li>').insertBefore(li);
                }
                $('.price-old').text(json['original_price']);
            }
            $('.price-new').text(json['original_special']);
        } else {
            // No special → ensure old price removed if exists, update new price
            if ($('.price-old').length) {
                $('.price-old').closest('li').remove();
            }
            if (json['price']) {
                $('.price-new').text(json['price']);
            }
        }
    }

    function updatePriceAjax() {
        var url = 'index.php?route=product/product.updatePrice&language={{ language }}';

        var payload = $('#form-product').serialize();

        $.ajax({
            url: url,
            type: 'post',
            data: payload,
            dataType: 'json',
            success: function(json) {

                if (json['error']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                    return;
                }

                renderPrice(json);
            },
            error: function(xhr, status, error) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> Price update failed. <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }
        });
    }

    // ---- bind listeners
    $(document).on('change', '#form-product select, #form-product input[type="radio"], #form-product input[type="checkbox"]', function() {
      $('#input-quantity').val(1);
      $('.starting-from').hide();
        updatePriceAjax();
    });

    // Optional: fire once on load to normalize UI (e.g., preselected options)
    $(document).ready(function() {
        // Clear browser storage
        if (typeof(Storage) !== 'undefined') {
            sessionStorage.clear();
            localStorage.removeItem('form-product-options');
        }
        
        // Clear all form selections
        $('#form-product')[0].reset();
        
        // Force clear all inputs multiple times to bypass any persistence
        $('#form-product select').each(function() {
            this.selectedIndex = 0;
            $(this).val('');
        });
        
        $('#form-product input[type="radio"], #form-product input[type="checkbox"]').prop('checked', false);
        
        // Show "Starting from"
        $('.starting-from').show();
        $('.selected-options').text('');
        
        updatePriceAjax();
    });
})();
</script>
<script>
var product_id = {{ product_id }};
var cart_products = {{ cart_products|json_encode()|raw }};

// Check if current product is in cart
function isProductInCart() {
    return cart_products.map(Number).includes(parseInt(product_id));
}

$('#checkout_direct').on('click', function () {

    // 1️⃣ If this product already exists in cart → go directly to cart
    if (isProductInCart()) {
        window.location = '{{ checkout }}';
        return;
    }

    // 2️⃣ Validate required OPTIONS before add-to-cart
    let hasError = false;

    $('#product .required select').each(function() {
        if (!$(this).val() || $(this).val().trim() === '') {
            hasError = true;
            $(this).addClass('is-invalid');
        } else {
            $(this).removeClass('is-invalid');
        }
    });

    if (hasError) {
        // same UX as OpenCart – highlight errors but DO NOT add to cart
        return;
    }

    // 3️⃣ Add to cart via AJAX
    $.ajax({
        url: 'index.php?route=checkout/cart.add&language={{ language }}',
        type: 'post',
        data: $('#product input, #product select, #product textarea'),
        dataType: 'json',
        success: function(json) {

            // Push product locally so second click goes direct
            cart_products.push(parseInt(product_id));

            // 4️⃣ Redirect ONLY if cart now has items
            if (cart_products.length > 0) {
                window.location = '{{ checkout }}';
            }
        }
    });
});
</script>
<script>
function updateSelectedOptionsText() {
    let selections = [];

    // SELECT options
// SELECT options
$('#form-product select').each(function () {
    let selectedOption = $(this).find('option:selected');
    let optionValue = selectedOption.val();

let value = selectedOption
  .text()
  .replace(/\s*\(.*?\)/g, '')
  .trim();

    if (!optionValue) return;

    selections.push(value);
});


    // RADIO options
    $('#form-product input[type="radio"]:checked').each(function () {
        let label = $(this).closest('.mb-3').find('.form-label').first().text().trim();
        let value = $(this).siblings('label').text().trim();

        selections.push(label + ': ' + value);
    });

    // CHECKBOX options
    let checkboxGroups = {};
    $('#form-product input[type="checkbox"]:checked').each(function () {
        let group = $(this).closest('.mb-3').find('.form-label').first().text().trim();
        let value = $(this).siblings('label').text().trim();

        if (!checkboxGroups[group]) checkboxGroups[group] = [];
        checkboxGroups[group].push(value);
    });

    for (let key in checkboxGroups) {
        selections.push(key + ': ' + checkboxGroups[key].join(', '));
    }

    // Render next to price
    if (selections.length > 0) {
        $('.selected-options').text('(' + selections.join(' | ') + ')');
    } else {
        $('.selected-options').text('');
    }
}

// 🔄 Bind on option change
$(document).on(
  'change',
  '#form-product select, #form-product input[type="radio"], #form-product input[type="checkbox"]',
  function () {
      updateSelectedOptionsText();
  }
);

// 🔁 Run once on page load
$(document).ready(function () {
    updateSelectedOptionsText();
});

const trigger = document.querySelector('.trigger-sticky-btn');
const stickyBtn = document.querySelector('.mobile-sticky-btn');

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        // When isIntersecting is false, the trigger is out of the viewport
        if (!entry.isIntersecting) {
            stickyBtn.classList.add('mobile-sticky');
        } else {
            stickyBtn.classList.remove('mobile-sticky');
        }
    });
}, {
    // threshold 0 means the moment even 1 pixel of the trigger disappears
    threshold: 0 
});

if (trigger) {
    observer.observe(trigger);
}
</script>



let qty = parseInt($('#input-quantity').val(), 10);

if (!qty || qty <= 0) {
    $('#input-quantity').addClass('is-invalid');

    $('#alert').prepend(
        '<div class="alert alert-danger alert-dismissible">' +
        '<i class="fa-solid fa-circle-exclamation"></i> ' +

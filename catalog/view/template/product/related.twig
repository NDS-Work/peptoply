{% if products %}
  <section class="related-products mb-5">
    <div class="container">
      <h3>{{ text_related }}</h3>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
    {% for product in products %}
      <div class="col mb-3">{{ product }}</div>
    {% endfor %}
  </div>
    </div>
  </section>
{% endif %}
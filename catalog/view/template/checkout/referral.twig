<fieldset id="referral-section" style="display: block;">
  <legend>Refer and Win</legend>
  <div id="referral-form">
    
    <div class="row row-cols-1 row-cols-md-2">
<div class="col mb-3">
      <label class="form-label">Referrer Name</label>
      <input type="text" name="referrer_name" placeholder="Enter Referrer Name" id="input-referrer-name" class="form-control">
    </div>
    <div class="col mb-3">
      <label class="form-label">Referrer Mobile</label>
      <input type="text" name="referrer_mobile" placeholder="Enter 10-digit mobile number" id="input-referrer-mobile" class="form-control" required>
    </div>
    </div>
    
    <div class="text-end mb-3 d-flex justify-content-md-between justify-content-end align-items-start flex-column flex-lg-row">
        <small id="referral-msg" class="text-success mt-2"></small>
      <button type="button" id="save-referral" class="btn btn-primary">Save Referral</button>

    </div>
  </div>
</fieldset>


<script>
$(document).on('click', '#save-referral', function() {
    var referrer_name = $('#input-referrer-name').val();
    var referrer_mobile = $('#input-referrer-mobile').val();

    $.ajax({
        url: 'index.php?route=checkout/referral.save&language=en-gb',
        type: 'post',
        data: {
            referrer_name: referrer_name,
            referrer_mobile: referrer_mobile
        },
        dataType: 'json',
        beforeSend: function() {
            $('#save-referral').prop('disabled', true);
            $('#referral-msg').text('');
        },
        complete: function() {
            $('#save-referral').prop('disabled', false);
        },
        success: function(json) {
            if (json.success) {
                $('#referral-msg').text(json.success).removeClass('text-danger').addClass('text-success');
            } else if (json.error) {
                $('#referral-msg').text(json.error).removeClass('text-success').addClass('text-danger');
            }
        },
        error: function(xhr, status, error) {
            $('#referral-msg').text('An error occurred!').removeClass('text-success').addClass('text-danger');
            console.error(error);
        }
    });
});
</script>

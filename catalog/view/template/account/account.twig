{{ header }}
<div id="content" class="container profile-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  {% if success %}
  <div class="alert alert-success alert-dismissible">
    <i class="fa-solid fa-circle-check"></i> {{ success }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {% endif %}

  <div class="row mb-5">
    <div class="col">

      <!-- Security / Profile Summary -->
      <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-primary text-white">
          <h1 class="h3 card-title mb-0">
            <i class="fas fa-shield-alt me-2"></i>{{ heading_title }}
          </h1>
        </div>
<div class="card-body">
  <div class="row align-items-center">
    
    <!-- Customer Info -->
<div class="col-md-9 mb-3 mb-md-0">
  <h2 class="h5 mb-2">{{ customer_name }}</h2>
  <div class="d-flex align-items-center mb-2">
    <span class="me-3">{{ mobile_number }}</span>
    {% if mobile_verified %}
    <span class="badge bg-success">
      <i class="fas fa-check-circle"></i> {{ text_mobile_verified }}
    </span>
    {% else %}
    <span class="badge bg-warning text-dark">
      <i class="fas fa-exclamation-triangle"></i> {{ text_mobile_not_verified }}
    </span>
    {% endif %}
  </div>
  <p class="mb-2">{{ customer_email }}</p>

  <!-- Reward Points in one line under email -->
{% if occupation == 47 or occupation == 48 %}
  <div class="d-inline-flex align-items-center bg-light p-2 flex-wrap gap-2 rounded shadow-sm">
    <div class="text-success">
      <i class="fas fa-gift fa-lg"></i>
    </div>
    <div class="flex-grow-1">
      You currently have <strong>{{ reward_points }}</strong> reward points.
    </div>
    <a href="{{ redeem_whatsapp }}" target="_blank" class="btn btn-success btn-sm">
      Redeem<i class="fab fa-whatsapp ms-1"></i>
    </a>
  </div>
  {% endif %}
</div>

    <!-- Logout Button -->
    <!-- <div class="col-md-3 text-md-end text-start">
      <a href="{{ logout }}" class="btn btn-outline-secondary mt-3 mt-md-0">{{ text_logout }}</a>
    </div> -->

  </div>
</div>
      </div>

      <!-- Dashboard Cards -->
      <div class="row">
                <!-- Order History -->
        <div class="col-sm-6 col-md-4 mb-3">
          <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column">
              <div class="mb-3 text-primary">
                <i class="fas fa-shopping-bag fa-2x"></i>
              </div>
              <h5 class="card-title">{{ text_order }}</h5>
              <p class="card-text flex-grow-1">View your order history and track shipments.</p>
              <a href="{{ order }}" class="btn btn-outline-primary">
                <i class="fas fa-list"></i> Orders
              </a>
            </div>
          </div>
        </div>
        
        <!-- Personal Information -->
        <div class="col-sm-6 col-md-4 mb-3">
          <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column">
              <div class="mb-3 text-primary">
                <i class="fas fa-user fa-2x"></i>
              </div>
              <h5 class="card-title">{{ text_edit }}</h5>
              <p class="card-text flex-grow-1">Update your personal information and contact details.</p>
              <a href="{{ edit }}" class="btn btn-outline-primary">
                <i class="fas fa-edit"></i> Edit Profile
              </a>
            </div>
          </div>
        </div>

        <!-- Address Book -->

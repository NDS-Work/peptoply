                <i class="fas fa-address-book fa-2x"></i>
              </div>
              <h5 class="card-title">{{ text_address }}</h5>
              <p class="card-text flex-grow-1">Manage your shipping and billing addresses.</p>
              <a href="{{ address }}" class="btn btn-outline-primary">
                <i class="fas fa-map-marker-alt"></i> Addresses
              </a>
            </div>
          </div>
        </div>


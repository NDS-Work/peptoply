{{ header }}
<div id="content" class="container onboarding-page">
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible">
    <i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {% endif %}

  {% if success %}
  <div class="alert alert-success alert-dismissible">
    <i class="fa-solid fa-circle-check"></i> {{ success }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  {% endif %}

  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-8">
      <div class="card border-0">
        <div class="card-body">
            <img src="{{ logo }}" class="onboarding-logo" alt="logo">
          <div id="mobile-step" class="verification-step">
            <div class="text-center">
              <h1 class="card-title text-primary">{{ heading_title }}</h1>
              <p class="mb-0">{{ text_mobile_login_only }}</p>
            </div>
            <div class="form-group mb-3">
              <label for="mobile-input" class="form-label">{{ text_mobile }}</label>
              <div class="input-group">
                <span class="input-group-text">+91</span>
                <input type="tel" id="mobile-input" class="ps-0 form-control form-control-lg"
                  placeholder="Enter 10-digit mobile number" maxlength="10" />
              </div>
              <small class="text-muted">Enter your 10-digit mobile number</small>
            </div>
            <button type="button" id="send-otp-btn" class="btn btn-primary btn-lg d-block mx-auto">
              <span class="btn-text">{{ text_send_otp }}</span>
              <span class="spinner-border spinner-border-sm d-none ms-2" role="status"></span>
            </button>
            <div class="mt-3 text-center">
              <small class="text-muted">We'll send you a verification code for secure login</small>
            </div>
          </div>

          <!-- Step 2: OTP Verification -->
          <div id="otp-step" class="verification-step" style="display: none;">
            <div class="text-center mb-3">
              <h2 class="text-primary">{{ text_otp }}</h2>
              <p class="text-muted">Enter 6 Digit Verification Code Sent to <span class="text-primary"
                  id="mobile-display"></span></p>
            </div>
            <div class="form-group mb-3">
              <input type="text" id="otp-input" class="form-control form-control-lg text-center"
                placeholder="{{ entry_otp }}" maxlength="6" style="font-size: 1.5rem; letter-spacing: 0.5rem;" />
            </div>
            <div class="d-flex justify-content-center align-items-center gap-3">
              <button type="button" id="verify-otp-btn" class="btn btn-primary d-block">
                <span class="btn-text">{{ text_verify_otp }}</span>
                <span class="spinner-border spinner-border-sm d-none ms-2" role="status"></span>
              </button>
              <button type="button" id="resend-otp-btn" class="btn btn-outline-secondary">
                {{ text_resend }}
              </button>
            </div>
            <div class="mt-3 text-center">
              <div id="debug-otp" class="alert alert-info" style="display: none;">
                <small><strong>Development Mode:</strong> Your OTP is: <span id="debug-otp-code"></span></small>
              </div>
            </div>
          </div>

          <!-- Step 3: Registration Form (for new users) -->
          <div id="registration-step" class="verification-step" style="display: none;">
            <div class="text-center mb-4">
              <h2 class="text-primary">Complete Your Registration</h2>
              <p class="text-muted">Please provide your details to create your account</p>
            </div>

            <form id="registration-form">

              <!-- Name Fields -->
              <div class="row">
                <div class="col-md-6">
                  <div class="form-group mb-3">
                    <label for="firstname" class="form-label">{{ entry_firstname }} <span
                        class="text-danger">*</span></label>
                    <input type="text" id="firstname" name="firstname" class="form-control" required />
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-group mb-3">
                    <label for="lastname" class="form-label">{{ entry_lastname }} <span
                        class="text-danger">*</span></label>
                    <input type="text" id="lastname" name="lastname" class="form-control" required />
                  </div>
                </div>
              </div>

              <!-- Email -->
              <div class="form-group mb-3">
                <label for="email" class="form-label">{{ entry_email }} <span class="text-danger">*</span></label>
                <input type="email" id="email" name="email" class="form-control" required />
              </div>

              <!-- Mobile Number Display (Read-only) -->
              <div class="form-group mb-3">
                <label class="form-label">Verified Mobile Number</label>
                <input type="text" id="verified-mobile" class="form-control" readonly />
              </div>

<!-- Custom Fields -->
{% for custom_field in custom_fields %}
  {% if custom_field.custom_field_id != 33 and custom_field.custom_field_id != 34 %}
    <div class="form-group mb-3">
      <label for="custom-field-{{ custom_field.custom_field_id }}" class="form-label">
        {{ custom_field.name }}
        {% if custom_field.required %}
          <span class="text-danger">*</span>
        {% endif %}
      </label>

      {% if custom_field.type == 'select' %}
        <select id="custom-field-{{ custom_field.custom_field_id }}" 
                name="custom_field[{{ custom_field.custom_field_id }}]" 
                class="form-select"
                {% if custom_field.required %}required{% endif %}>
          <option disabled value="">Please Select</option>
          {% for custom_field_value in custom_field.custom_field_value %}
            <option value="{{ custom_field_value.custom_field_value_id }}">{{ custom_field_value.name }}</option>
          {% endfor %}
        </select>

      {% elseif custom_field.type == 'radio' %}
        {% for custom_field_value in custom_field.custom_field_value %}
          <div class="form-check">
            <input type="radio"
                   id="custom-field-{{ custom_field.custom_field_id }}-{{ custom_field_value.custom_field_value_id }}"
                   name="custom_field[{{ custom_field.custom_field_id }}]"
                   value="{{ custom_field_value.custom_field_value_id }}"
                   class="form-check-input"
                   {% if custom_field.required %}required{% endif %} />
            <label for="custom-field-{{ custom_field.custom_field_id }}-{{ custom_field_value.custom_field_value_id }}"
                   class="form-check-label">{{ custom_field_value.name }}</label>
          </div>
        {% endfor %}

      {% elseif custom_field.type == 'checkbox' %}
        {% for custom_field_value in custom_field.custom_field_value %}
          <div class="form-check">
            <input type="checkbox"
                   id="custom-field-{{ custom_field.custom_field_id }}-{{ custom_field_value.custom_field_value_id }}"
                   name="custom_field[{{ custom_field.custom_field_id }}][]"
                   value="{{ custom_field_value.custom_field_value_id }}"
                   class="form-check-input" />
            <label for="custom-field-{{ custom_field.custom_field_id }}-{{ custom_field_value.custom_field_value_id }}"
                   class="form-check-label">{{ custom_field_value.name }}</label>
          </div>
        {% endfor %}

      {% elseif custom_field.type == 'text' %}
        <input type="hidden"
               id="custom-field-{{ custom_field.custom_field_id }}"
               name="custom_field[{{ custom_field.custom_field_id }}]"
               class="form-control dob-field"
               {% if custom_field.required %}required{% endif %} />
        <div class="birth-date-select d-flex gap-2">
          <select id="birth-day-field" class="form-control" required>
            <option value="" disabled>Day</option>
          </select>
          <select id="birth-month-field" class="form-control" required>
            <option value="" disabled selected>Month</option>
            <option value="January" data-month="01">January</option>
            <option value="February" data-month="02">February</option>
            <option value="March" data-month="03">March</option>
            <option value="April" data-month="04">April</option>
            <option value="May" data-month="05">May</option>
            <option value="June" data-month="06">June</option>
            <option value="July" data-month="07">July</option>
            <option value="August" data-month="08">August</option>
            <option value="September" data-month="09">September</option>
            <option value="October" data-month="10">October</option>
            <option value="November" data-month="11">November</option>
            <option value="December" data-month="12">December</option>
          </select>
        </div>

      {% elseif custom_field.type == 'textarea' %}
        <textarea id="custom-field-{{ custom_field.custom_field_id }}"
                  name="custom_field[{{ custom_field.custom_field_id }}]"
                  class="form-control"
                  rows="3"
                  {% if custom_field.required %}required{% endif %}></textarea>
      {% endif %}
    </div>
  {% endif %}
{% endfor %}


              <button type="submit" id="complete-registration-btn" class="btn btn-primary btn-lg w-100">
                <span class="btn-text">{{ button_complete }}</span>
                <span class="spinner-border spinner-border-sm d-none ms-2" role="status"></span>
              </button>
            </form>
          </div>

          <!-- Success Step -->
          <div id="success-step" class="verification-step text-center" style="display: none;">
            <div class="mb-3">
              <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
            </div>
            <h5 class="text-success">Success!</h5>
            <p class="text-muted" id="success-message"></p>
            <p class="text-muted">Redirecting...</p>
          </div>

          <!-- Alert Messages -->
        </div>
      </div>
      <div id="alert-container" class="mt-3"></div>
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    console.log('Mobile verification script loaded');

    const mobileInput = document.getElementById('mobile-input');
    const otpInput = document.getElementById('otp-input');
    const sendOtpBtn = document.getElementById('send-otp-btn');
    const verifyOtpBtn = document.getElementById('verify-otp-btn');
    const resendOtpBtn = document.getElementById('resend-otp-btn');
    const completeRegistrationBtn = document.getElementById('complete-registration-btn');
    const registrationForm = document.getElementById('registration-form');

    let currentMobile = '';
    let resendTimer = 0;

    // Get URLs from template
    const sendOtpUrl = '{{ send_otp|raw }}';
    const verifyOtpUrl = '{{ verify_otp|raw }}';
    const completeRegistrationUrl = '{{ complete_registration|raw }}';

    console.log('URLs:', { sendOtpUrl, verifyOtpUrl, completeRegistrationUrl });

    // Show alert function
    function showAlert(message, type = 'danger') {
      console.log('Showing alert:', message, type);
      const alertContainer = document.getElementById('alert-container');
      alertContainer.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
      alertContainer.scrollIntoView({ behavior: 'smooth' });
    }

    // Show step function
    function showStep(stepId) {
      console.log('Showing step:', stepId);
      document.querySelectorAll('.verification-step').forEach(step => {
        step.style.display = 'none';
      });
      document.getElementById(stepId).style.display = 'block';
    }

    // Button loading state
    function setButtonLoading(button, isLoading) {
      const btnText = button.querySelector('.btn-text');
      const spinner = button.querySelector('.spinner-border');

      if (isLoading) {
        button.disabled = true;
        if (spinner) spinner.classList.remove('d-none');
      } else {
        button.disabled = false;
        if (spinner) spinner.classList.add('d-none');
      }
    }

    // Mobile number formatting
    if (mobileInput) {
      mobileInput.addEventListener('input', function () {
        this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);
      });
    }

    // OTP input formatting
    if (otpInput) {
      otpInput.addEventListener('input', function () {
        this.value = this.value.replace(/[^0-9]/g, '').substring(0, 6);
      });
    }

    // Send OTP - Updated to include +91
    if (sendOtpBtn) {
      sendOtpBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const mobile = mobileInput.value.trim();

        if (!mobile) {
          showAlert('Please enter your mobile number');
          return false;
        }

        if (mobile.length !== 10) {
          showAlert('Please enter a valid 10-digit mobile number');
          return false;
        }

        // Add +91 prefix before sending
        const fullMobile = '+91' + mobile;

        setButtonLoading(sendOtpBtn, true);

        console.log('Sending OTP to:', fullMobile);

        fetch(sendOtpUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: 'mobile=' + encodeURIComponent(fullMobile) // Send with +91
        })
          .then(response => response.json())
          .then(data => {
            setButtonLoading(sendOtpBtn, false);

            if (data.error) {
              showAlert(data.error);
            } else if (data.success) {
              currentMobile = data.mobile || fullMobile;
              document.getElementById('mobile-display').textContent = currentMobile;

              // Show debug OTP in development
              if (data.debug_otp) {
                document.getElementById('debug-otp-code').textContent = data.debug_otp;
                document.getElementById('debug-otp').style.display = 'block';
              }

              showStep('otp-step');
              showAlert(data.success, 'success');
              if (otpInput) otpInput.focus();

              // Start resend timer
              startResendTimer();
            }
          })
          .catch(error => {
            setButtonLoading(sendOtpBtn, false);
            showAlert('Network error. Please try again.');
            console.error('Error:', error);
          });

        return false;
      });
    }

    // Verify OTP
    if (verifyOtpBtn) {
      verifyOtpBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const otp = otpInput.value.trim();

        if (!otp) {
          showAlert('Please enter the verification code');
          return;
        }

        if (otp.length !== 6) {
          showAlert('Please enter the complete 6-digit code');
          return;
        }

        setButtonLoading(verifyOtpBtn, true);

        fetch(verifyOtpUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: 'mobile=' + encodeURIComponent(currentMobile) + '&otp=' + encodeURIComponent(otp)
        })
          .then(response => response.json())
          .then(data => {
            setButtonLoading(verifyOtpBtn, false);

            if (data.error) {
              showAlert(data.error);
            } else {
              showAlert(data.success, 'success');

              if (data.action === 'login') {
                // Existing user - redirect to account
                document.getElementById('success-message').textContent = 'Welcome back! Redirecting to your account...';
                showStep('success-step');
                setTimeout(() => {
                  window.location.href = data.redirect;
                }, 2000);
              } else if (data.action === 'register') {
                // New user - show registration form
                document.getElementById('verified-mobile').value = currentMobile;
                showStep('registration-step');
              }
            }
          })
          .catch(error => {
            setButtonLoading(verifyOtpBtn, false);
            showAlert('Network error. Please try again.');
            console.error('Error:', error);
          });
      });
    }

    // Complete Registration
    if (registrationForm) {
      registrationForm.addEventListener('submit', function (e) {
        e.preventDefault();

        const formData = new FormData(this);

        setButtonLoading(completeRegistrationBtn, true);

        fetch(completeRegistrationUrl, {
          method: 'POST',
          body: formData
        })
          .then(response => response.json())
          .then(data => {
            setButtonLoading(completeRegistrationBtn, false);

            if (data.error) {
              showAlert(data.error);
            } else {
              document.getElementById('success-message').textContent = 'Registration completed! Welcome to our store.';
              showStep('success-step');
              showAlert(data.success, 'success');

              setTimeout(() => {
                window.location.href = data.redirect;
              }, 2000);
            }
          })
          .catch(error => {
            setButtonLoading(completeRegistrationBtn, false);
            showAlert('Network error. Please try again.');
            console.error('Error:', error);
          });
      });
    }

    // Update resend OTP to also use +91
    if (resendOtpBtn) {
      resendOtpBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        if (resendTimer > 0) return;

        setButtonLoading(resendOtpBtn, true);

        fetch(sendOtpUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: 'mobile=' + encodeURIComponent(currentMobile) // This already has +91
        })
          .then(response => response.json())
          .then(data => {
            setButtonLoading(resendOtpBtn, false);

            if (data.error) {
              showAlert(data.error);
            } else {
              if (data.debug_otp) {
                document.getElementById('debug-otp-code').textContent = data.debug_otp;
                document.getElementById('debug-otp').style.display = 'block';
              }

              showAlert('New code sent to your mobile', 'success');
              startResendTimer();
            }
          })
          .catch(error => {
            setButtonLoading(resendOtpBtn, false);
            showAlert('Failed to resend code. Please try again.');
          });
      });
    }

    // Resend timer
    function startResendTimer() {
      resendTimer = 60;
      if (resendOtpBtn) {
        resendOtpBtn.disabled = true;

        const interval = setInterval(() => {
          resendTimer--;
          resendOtpBtn.textContent = `Resend (${resendTimer}s)`;

          if (resendTimer <= 0) {
            clearInterval(interval);
            resendOtpBtn.disabled = false;
            resendOtpBtn.textContent = 'Resend Code';
          }
        }, 1000);
      }
    }

    // Enter key handlers
    if (mobileInput) {
      mobileInput.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          sendOtpBtn.click();
        }
      });
    }

    if (otpInput) {
      otpInput.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          verifyOtpBtn.click();
        }
      });
    }

    console.log('Mobile verification script initialization complete');
  });

let daySelect = document.getElementById("birth-day-field");
let monthSelect = document.getElementById("birth-month-field");
let hiddenInput = document.getElementById("custom-field-29");

function populateDays(monthNumber, defaultDay) {
    daySelect.innerHTML = "";

    let daysInMonth = 31;
    if (["04", "06", "09", "11"].includes(monthNumber)) {
        daysInMonth = 30;
    } else if (monthNumber === "02") {
        daysInMonth = 29; // Feb max days
    }

    // If previous day > daysInMonth → clamp to max
    if (parseInt(defaultDay, 10) > daysInMonth) {
        defaultDay = daysInMonth.toString().padStart(2, "0");
    }

    for (let i = 1; i <= daysInMonth; i++) {
        let option = document.createElement("option");
        option.value = i.toString().padStart(2, "0");
        option.textContent = i;
        if (option.value === defaultDay) {
            option.selected = true;
        }
        daySelect.appendChild(option);
    }
}

function updateHiddenInput() {
    let day = daySelect.value;
    let monthName = monthSelect.value;
    if (day && monthName) {
        hiddenInput.value = `${day}-${monthName}`;
    }
}

monthSelect.addEventListener("change", function () {
    let monthNumber = this.options[this.selectedIndex].dataset.month;
    let currentDay = daySelect.value || "01"; // keep current day if set
    populateDays(monthNumber, currentDay);
    updateHiddenInput();
});

daySelect.addEventListener("change", updateHiddenInput);

// --- Run on page load ---
window.addEventListener("DOMContentLoaded", function () {
    let defaultMonthNumber = monthSelect.options[monthSelect.selectedIndex].dataset.month;
    let defaultDay = daySelect.value || "01";
    populateDays(defaultMonthNumber, defaultDay);
    updateHiddenInput();
});

</script>


{{ footer }}
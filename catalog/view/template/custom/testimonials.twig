<section class="peptoply-testimonials-section py-4 py-md-5">
  <div class="container">
    <h2 class="mb-md-5 mb-4">What Our Customers Say</h2>
    {% set testimonials = [
      {
        'avatar': 'image/catalog/peptoply/testimonials/image.webp',
        'name': 'Devinder Kashyap',
        'role': 'Interior designer Decora Design Industries',
        'heading': 'Great Service, Great Quality!',
        'stars': 5,
        'review': 'Pepto Ply stands out with its advanced anti-termite technology, ensuring long-lasting protection and durability for all your wooden needs. Unlike traditional plywood, it is engineered with a unique termite-resistant formulation that penetrates deep into the wood, offering unparalleled defense against infestations. This makes Pepto Ply the ideal choice for homeowners and businesses seeking reliable, high-quality, and maintenance-free solutions.'
      },
      {
        'avatar': 'image/catalog/peptoply/testimonials/image-1.webp',
        'name': 'Mr. Vibhor Garg',
        'role': 'Architects Studio',
        'heading': 'Best Plywood for Projects',
        'stars': 4,
        'review': 'I always recommend Pepto Ply for my clients. The anti-termite property really works and saves us long-term headaches. Delivery is always on time and the finish is excellent.'
      },
      {
        'avatar': 'image/catalog/peptoply/testimonials/image-2.webp',
        'name': 'mr. Gaurav Chauhan',
        'role': 'Afflatus Design Studio',
        'heading': 'Truly Worry-free!',
        'stars': 3,
        'review': 'After using Pepto Ply in my kitchen, I have had zero issues with termites. The quality is much better than other brands I’ve tried.'
      }
    ] %}
    <div class="peptoply-row">
      <!-- Thumbnail swiper -->
      <div class="peptoply-left">
        <div thumbsSlider="" class="swiper peptoply-mySwiper-side">
          <div class="swiper-wrapper">
            {% for testimonial in testimonials %}
              <div class="swiper-slide peptoply-slide text-center">
                <img src="{{ base }}{{ testimonial.avatar }}" class="img-box rounded-circle" alt="{{ testimonial.name }}">
                <div class="content-box">
                  <h4 class="mt-0">{{ testimonial.name }}</h4>
                  <p class="mb-0">{{ testimonial.role }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <!-- Main swiper -->
      <div class="peptoply-right">
        <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper peptoply-mySwiper-main">
          <div class="swiper-wrapper">
            {% for testimonial in testimonials %}
              <div class="swiper-slide">
                <div class="peptoply-main-slide">
                <div class="peptoply-star-rating mb-2">
                    {% for i in 1..testimonial.stars %}
                      <img src="{{ base }}image/catalog/peptoply/testimonials/star-icon.svg" alt="star">
                    {% endfor %}
                  </div>
                  <h3>{{ testimonial.heading }}</h3>
                  <p>{{ testimonial.review }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
                        <div class="peptoply-swiper-navigation">
                <div class="peptoply-swiper-button-prev">
                  <svg width="41" height="40" viewBox="0 0 41 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20.5" cy="20" r="20" fill="white" />
                    <path d="M23.5 13L16.5 20L23.5 27" stroke="#1C4955" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </div>
                <div class="peptoply-swiper-button-next">
                  <svg width="42" height="40" viewBox="0 0 42 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20.5" cy="20" r="20" fill="white" />
                    <path d="M18 27L25 20L18 13" stroke="#1C4955" stroke-width="2" stroke-linecap="round" />
